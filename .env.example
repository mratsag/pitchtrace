# PitchTrace — dikey dilim
# cp .env.example .env ve değerleri doldurun.

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_USER=pitchtrace
POSTGRES_PASSWORD=change-me-before-running
POSTGRES_DB=pitchtrace

# ── Analyzer ──────────────────────────────────────────────────────────────
# Uzun ve rastgele olmalı:  openssl rand -hex 32
ANALYZER_API_KEY=change-me-before-running

# ── n8n (yalnızca --profile n8n ile) ─────────────────────────────────────
# Her ikisini de bağımsız, uzun ve rastgele değerlerle değiştirin.
# openssl rand -hex 32
N8N_DB_PASSWORD=change-me-before-running
N8N_ENCRYPTION_KEY=change-me-before-running
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_HOST_PORT=5678

# Eşzamanlı audit sayısı. Hard ceiling 2'dir; daha büyük değer 2'ye kırpılır.
AUDIT_CONCURRENCY=2

# Screenshot dosyalarının saklanma süresi (gün). Süresi dolan dosya silinir,
# kaydı deleted_at ile işaretlenir ve GET /artifacts/{id} 404 ARTIFACT_GONE döner.
ARTIFACT_RETENTION_DAYS=30

# Sertifika hataları sayfa render'ını durdurmasın (varsayılan: açık).
# Kapatılırsa süresi dolmuş sertifikası olan siteler hiç analiz edilemez ve
# TECH_TLS_EXPIRED bulgusu üretilemez. Analyzer sayfaya kimlik bilgisi
# göndermez; sertifika ayrıca doğrudan okunup bulguya dönüştürülür.
TLS_IGNORE_ERRORS=true

# ── Performans ölçümü ─────────────────────────────────────────────────────
# Eşikler (üretim varsayılanları). Ölçüm yalnızca ANA SAYFADA yapılır.
# PERF_TTFB_SLOW_MS=800
# PERF_LCP_SLOW_MS=4000
# PERF_PAGE_WEIGHT_HIGH_BYTES=3145728
#
# Ölçüm penceresi: navigasyon başlangıcından itibaren ölçümün açık kaldığı
# süre. Boş bırakılırsa PERF_LCP_SLOW_MS + 1000 kullanılır. Pencere LCP
# eşiğinden KISA olursa yavaş bir sitenin LCP'si hiç boyanmadan ölçüm kapanır
# ve bulgu sessizce kaçırılır. Audit başına ~5 saniye maliyeti vardır.
# PERF_MEASURE_WINDOW_MS=

# PageSpeed Insights (CrUX) alan verisi — TAMAMEN OPSİYONEL.
# Anahtar yoksa hiçbir istek yapılmaz. PSI verisi yalnızca kanıtı
# zenginleştirir; bir bulgunun oluşup oluşmayacağını asla değiştirmez.
# PSI_API_KEY=

# ── Geliştirme portları (yalnızca docker-compose.dev.yml ile) ─────────────
POSTGRES_HOST_PORT=5433
ANALYZER_HOST_PORT=8080

# ── SADECE TEST ───────────────────────────────────────────────────────────
# SSRF_ALLOW_LOOPBACK, yalnızca yerel fixture sunucusuna karşı test koşarken
# 1 yapılır ve SADECE 127.0.0.0/8 ile ::1'i serbest bırakır. Link-local
# (169.254.0.0/16, cloud metadata dahil), private ve reserved aralıklar bu
# bayrakla da AÇILMAZ. NODE_ENV=production iken servis başlamayı reddeder.
# SSRF_ALLOW_LOOPBACK=0
