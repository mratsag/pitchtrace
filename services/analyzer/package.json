{
  "name": "@pitchtrace/analyzer",
  "version": "0.1.0-alpha.7",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node dist/src/db/migrate-cli.js",
    "start": "node dist/src/index.js",
    "test": "node --test --test-concurrency=1 \"dist/tests/**/*.test.js\"",
    "test:unit": "node --test \"dist/tests/unit/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"dist/tests/integration/**/*.test.js\"",
    "docs:findings": "node dist/src/findings/docs-cli.js"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "pg": "^8.13.0",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.11.10",
    "node-forge": "^1.4.0",
    "typescript": "^5.7.0"
  }
}
