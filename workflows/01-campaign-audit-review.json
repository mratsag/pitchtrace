      "id": "7f0df130-50ac-4ae5-a6ef-62ce8a3606ab",
      "name": "Validate and Store Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1480,
        -280
      ],
      "notes": "Validator 422 yalnız o firmayı atlar; diğer hatalar tek denemeden sonra yürütmeyi durdurur."
    },
    {
      "parameters": {
        "jsCode": "const built = $('Build Deterministic Evidence Draft').all().map((i) => i.json);\nconst skipped = [...built[0].skipped];\nconst stored = [];\n$input.all().forEach((response, i) => {\n  const status = Number(response.json.statusCode ?? 0);\n  const b = built[i];\n  const c = b.context.company;\n  if (status === 201) {\n    stored.push({ draft_id: response.json.body.draft_id, body: response.json.body.body, subject: b.output.subject, company: c,\n      contact_email: b.context.contact.email, score: b.context.score, artifact_id: b.artifact_id });\n    return;\n  }\n  if (status === 422) {\n    skipped.push({ company_id: c.id, name: c.name, domain: c.domain, reason: 'VALIDATOR_REJECTED', reason_text: 'taslak V1–V16 doğrulamasından geçmedi' });\n    return;\n  }\n  // Draft creation is not retry-safe: stop after this single attempt.\n  throw new Error(`ANALYZER_REQUEST_FAILED (HTTP ${status || 'yok'}, 1 deneme, Validate and Store Draft): Taslak kaydedilemedi; tekrar denenmedi, hassas yanıt ayrıntıları gizlendi.`);\n});\nif (!stored.length) return [{ json: { no_candidate: true, skipped } }];\nreturn stored.map((d) => ({ json: { ...d, skipped } }));"
      },
