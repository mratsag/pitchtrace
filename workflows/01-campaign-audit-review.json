      "name": "Increment Poll Counter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [820, 80]
    },
    {
      "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 }, "conditions": [ { "id": "timeout", "leftValue": "={{ $json.pollAttempt }}", "rightValue": "={{ $('Workflow Config').first().json.pollMaxAttempts }}", "operator": { "type": "number", "operation": "gte" } } ], "combinator": "and" }, "options": {} },
      "id": "9652b190-5ad0-4847-bd2b-d04e1d282340",
