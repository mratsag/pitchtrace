      "position": [-500, 0]
    },
    {
      "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 }, "conditions": [ { "id": "audit-approved", "leftValue": "={{ $json.audit_decision }}", "rightValue": "Başlat", "operator": { "type": "string", "operation": "equals" } } ], "combinator": "and" }, "options": {} },
      "id": "32f81da9-c5fa-4925-8ae8-15016858376b",
