    {
      "parameters": { "operation": "completion", "respondWith": "text", "completionTitle": "Audit zaman aşımı", "completionMessage": "Auditler yaklaşık 60 dakikalık bekleme bütçesinde terminal duruma ulaşmadı. Kuyruk PostgreSQL'de korunur; daha sonra progress endpoint'inden devam edin.", "options": {} },
      "id": "cb05600b-e438-4546-b324-2bc5ab5eb29f",
      "name": "Audit Timeout Result",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.5,
      "position": [1260, 20]
    },
    {
      "parameters": { "jsCode": "const imported = $('Import CSV').first().json.results.filter(r => r.status === 'imported' && r.company_id); if (!imported.length) throw new Error('No eligible imported company is available for review'); return [{json:{company_id: imported[0].company_id, progress:$json}}];" },
      "id": "902cff28-976f-421c-9245-caac921242ef",
      "name": "Select Review Company",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [820, -180]
    },
    {
      "parameters": { "url": "={{ $('Workflow Config').first().json.analyzerBaseUrl + '/drafts/context?company_id=' + $json.company_id }}", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "options": { "timeout": 10000 } },
      "id": "25e21c1c-654f-4e87-a53d-bfdca20fe198",
      "name": "Get Draft Context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [1040, -180]
    },
    {
      "parameters": { "jsCode": "const context=$json; const finding=context.findings.find(f=>f.outreach_eligible && f.confidence==='observed'); if(!finding) throw new Error('No outreach-eligible observed finding is available'); const output={language:context.language,subject:'Web siteniz hakkında kısa bir teknik gözlem',greeting:'Merhaba,',claims:[{text:'Kayıtlı web sitesi bulgusu tarafımızca doğrulandı.',claim_type:'assertion',confidence:'observed',finding_ids:[finding.id]},{text:'Bu bulguyu birlikte incelemek ister misiniz?',claim_type:'question',confidence:'observed',finding_ids:[]}],closing:'İyi çalışmalar.'}; const artifact=context.findings.find(f=>f.artifact_id)?.artifact_id ?? null; return [{json:{context,output,artifact_id:artifact}}];" },
      "id": "03f22473-5686-4534-b4b4-dfb095a350c9",
      "name": "Build Deterministic Evidence Draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1260, -180]
    },
    {
      "parameters": { "method": "POST", "url": "={{ $('Workflow Config').first().json.analyzerBaseUrl + '/drafts' }}", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendBody": true, "contentType": "raw", "rawContentType": "application/json", "body": "={{ JSON.stringify({audit_id:$json.context.audit_id, contact_id:$json.context.contact.id, output:$json.output}) }}", "options": { "timeout": 10000 } },
      "id": "7f0df130-50ac-4ae5-a6ef-62ce8a3606ab",
      "name": "Validate and Store Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [1480, -180]
    },
    {
      "parameters": { "url": "={{ $('Workflow Config').first().json.analyzerBaseUrl + '/artifacts/' + $('Build Deterministic Evidence Draft').first().json.artifact_id }}", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "options": { "response": { "response": { "responseFormat": "file", "outputPropertyName": "screenshot" } }, "timeout": 10000 } },
      "id": "7276a2fe-55bc-44a3-8e86-ad49a799ab68",
      "name": "Fetch Controlled Screenshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [1700, -180],
      "continueOnFail": true
    },
    {
      "parameters": {
        "operation": "page",
        "defineForm": "json",
        "jsonOutput": "[{\"fieldLabel\":\"review_decision\",\"fieldType\":\"radio\",\"fieldOptions\":{\"values\":[{\"option\":\"Onayla\"},{\"option\":\"Reddet\"}]},\"requiredField\":true},{\"fieldLabel\":\"rejection_note\",\"fieldType\":\"textarea\",\"requiredField\":false}]",
        "options": {
          "formTitle": "Kanıta bağlı taslak incelemesi",
          "formDescription": "={{ '<p><strong>Firma:</strong> ' + $('Get Draft Context').first().json.company.name + ' (' + $('Get Draft Context').first().json.company.domain + ')</p><p><strong>Audit:</strong> completed · başarısız işler: ' + $('Get Audit Progress').last().json.failed + '</p><p><strong>Konu:</strong> ' + $('Build Deterministic Evidence Draft').first().json.output.subject + '</p><pre>' + $('Validate and Store Draft').first().json.body + '</pre><img alt=\"Audit screenshot\" style=\"max-width:375px;border:1px solid #ccc\" src=\"/webhook/pitchtrace-artifact-preview?artifact_id=' + $('Build Deterministic Evidence Draft').first().json.artifact_id + '\"><p>Onay yalnız .eml hazırlar; otomatik e-posta göndermez.</p>' }}",
          "buttonLabel": "İnceleme kararını kaydet"
        }
      },
