      "id": "89d424d8-80bb-4592-978e-96c3fe91ef3f",
      "name": "Human Draft Review",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.5,
      "position": [
        2580,
        -400
      ]
    },
    {
      "parameters": {
        "jsCode": "const form = $input.first().json;\nconst review = $('Assemble Review Page').first().json.review;\nconst approved = [];\nlet rejected = 0;\nfor (const r of review) {\n  const decision = form[`decision_${r.n}`];\n  if (decision === 'Onayla') approved.push(r);\n  else if (decision === 'Reddet') rejected += 1;\n  else throw new Error(`Taslak ${r.n} için karar eksik; hiçbir onay kaydedilmedi.`);\n}\nif (!approved.length) return [{ json: { approved_count: 0, rejected_count: rejected } }];\nreturn approved.map((r) => ({ json: { ...r, approved_count: approved.length, rejected_count: rejected } }));"
      },
      "id": "5f5a3f60-5c09-43cb-aed3-6d2ee864ede4",
      "name": "Resolve Review Decisions",
