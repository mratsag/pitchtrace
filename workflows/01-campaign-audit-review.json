      "parameters": { "jsCode": "const id = String($json.query?.artifact_id ?? ''); if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(id)) throw new Error('Invalid artifact id'); return [{json:{artifact_id:id}}];" },
