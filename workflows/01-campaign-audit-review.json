    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst approved = $('Resolve Review Decisions').all().map((i) => i.json);\nconst binary = {};\nitems.forEach((item, i) => {\n  const file = item.binary?.eml;\n  if (!file) throw new Error('Onaylanan taslağın .eml dosyası alınamadı.');\n  const key = items.length === 1 ? 'export' : `eml_${i + 1}`;\n  binary[key] = { ...file, fileName: `${String(i + 1).padStart(2, '0')}-${approved[i].domain}.eml` };\n});\nreturn [{ json: { approved_count: items.length, rejected_count: approved[0].rejected_count, binary_keys: Object.keys(binary).join(','), zip: items.length > 1 }, binary }];"
      },
