      "id": "e84d23ee-5a58-493a-97e6-86b31ea70076",
      "name": "Get Audit Progress",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [380, -100]
    },
    {
      "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 }, "conditions": [ { "id": "terminal", "leftValue": "={{ $json.terminal }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } } ], "combinator": "and" }, "options": {} },
      "id": "bb81ecdb-b287-4119-883a-6a91477cb073",
