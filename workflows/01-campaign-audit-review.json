      "id": "25e21c1c-654f-4e87-a53d-bfdca20fe198",
      "name": "Get Draft Context",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        820,
        -180
      ],
      "notes": "Kampanya düzeyinde tek retry-safe okuma; uygun olmayan firmalar gerekçesiyle atlanır."
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst reasonText = { SCORE_BELOW_THRESHOLD: 'skor kampanya eşiğinin altında', SUPPRESSED: 'alıcı veya domain bastırma listesinde',\n  DRAFT_CONTEXT_NOT_FOUND: 'tamamlanmış audit, skor veya kişi bulunamadı', NO_ELIGIBLE_FINDING: 'outreach için uygun gözlenmiş bulgu yok',\n  NO_SCREENSHOT: 'ekran görüntüsü yok' };\nconst skipped = (data.skipped ?? []).map((s) => ({ ...s, reason_text: reasonText[s.reason] ?? s.reason }));\nconst drafts = [];\nfor (const context of data.contexts ?? []) {\n  const c = context.company;\n  const skip = (reason) => skipped.push({ company_id: c.id, name: c.name, domain: c.domain, reason, reason_text: reasonText[reason] });\n  const finding = context.findings.find((f) => f.outreach_eligible && f.confidence === 'observed');\n  if (!finding) { skip('NO_ELIGIBLE_FINDING'); continue; }\n  if (!context.screenshot_artifact_id) { skip('NO_SCREENSHOT'); continue; }\n  const output = { language: context.language, subject: 'Web siteniz hakkında kısa bir teknik gözlem', greeting: 'Merhaba,',\n    claims: [{ text: 'Kayıtlı web sitesi bulgusu tarafımızca doğrulandı.', claim_type: 'assertion', confidence: 'observed', finding_ids: [finding.id] },\n      { text: 'Bu bulguyu birlikte incelemek ister misiniz?', claim_type: 'question', confidence: 'observed', finding_ids: [] }],\n    closing: 'İyi çalışmalar.' };\n  drafts.push({ context, output, artifact_id: context.screenshot_artifact_id });\n}\nif (!drafts.length) return [{ json: { no_candidate: true, skipped } }];\nreturn drafts.map((d) => ({ json: { ...d, skipped } }));"
      },
