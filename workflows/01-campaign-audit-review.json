    {
      "parameters": {
        "jsCode": "const esc = (s) => String(s ?? '').replace(/[&<>\"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' })[ch]);\nconst drafts = $('Collect Stored Drafts').all().map((i) => i.json);\nconst previews = $input.all().map((i) => i.json);\nif (previews.length !== drafts.length) throw new Error('Önizleme sayısı taslak sayısıyla eşleşmiyor; inceleme durduruldu.');\nconst fields = [];\nconst review = [];\ndrafts.forEach((d, i) => {\n  const n = i + 1;\n  const p = previews[i];\n  fields.push({ fieldType: 'html', html: `<h3>${n}. ${esc(d.company.name)} (${esc(d.company.domain)})</h3>`\n    + `<p><strong>Alıcı:</strong> ${esc(d.contact_email)} · <strong>Skor:</strong> ${esc(d.score)}</p>`\n    + `<p><strong>Konu:</strong> ${esc(d.subject)}</p><pre>${esc(d.body)}</pre>`\n    + `<img alt=\"Audit screenshot ${n}; bağlantının süresi dolduysa aşağıdaki yenileme bağlantısını kullanın\" width=\"375\" referrerpolicy=\"no-referrer\" src=\"${esc(p.preview_url)}\">`\n    + `<p><a target=\"_blank\" rel=\"noreferrer\" href=\"${esc(p.refresh_url)}\">Bu firma için yeni güvenli önizleme isteyin</a></p>` });\n  fields.push({ fieldName: `decision_${n}`, fieldLabel: `${n}. ${d.company.name} (${d.company.domain}) kararı`, fieldType: 'radio',\n    fieldOptions: { values: [{ option: 'Onayla' }, { option: 'Reddet' }] }, requiredField: true });\n  review.push({ n, draft_id: d.draft_id, company_id: d.company.id, name: d.company.name, domain: d.company.domain });\n});\nconst skipped = drafts[0].skipped;\nconst skippedHtml = skipped.length\n  ? `<p><strong>Atlanan firmalar (${skipped.length}):</strong></p><ul>${skipped.map((s) => `<li>${esc(s.name)} (${esc(s.domain)}): ${esc(s.reason_text)}</li>`).join('')}</ul>`\n  : '';\nconst description = `<p><strong>${drafts.length}</strong> taslak incelemenizi bekliyor. Her taslak için ayrı karar verin; yalnız onaylananlar için .eml hazırlanır.</p>`\n  + skippedHtml\n  + '<p><strong>Önizleme bağlantısının süresi dolduysa</strong> ilgili firmanın altındaki bağlantıdan aynı görsel için yeni güvenli önizleme isteyin. Bu işlem onay, audit veya draft oluşturmaz.</p>'\n  + '<p>Görsel bağlantıları kısa ömürlüdür. Onay yalnız .eml hazırlar; otomatik e-posta göndermez.</p>';\nreturn [{ json: { review, review_fields: fields, description_html: description } }];"
      },
      "id": "4f743747-a407-4366-9402-acab59589798",
      "name": "Assemble Review Page",
