      "name": "Classify Retry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "const init=$('Initialize Retry State').first().json; const attempt=$runIndex+1; const status=Number($json.statusCode??$json.status??0); const network=!status||Boolean($json.error); const transient=network||[408,425,429,500,502,503,504].includes(status); const retry=Boolean(init.retry_safe)&&transient&&attempt<Number(init.max_attempts); const retryAfter=Number($json.headers?.['retry-after']??0); const delayMs=Math.min(10000,retryAfter>0?retryAfter*1000:500*(2**(attempt-1))+Math.floor(Math.random()*250)); if(retry) return [{json:{method:init.method,url:init.url,retry_safe:init.retry_safe,operation:init.operation,attempt,should_retry:true,delay_ms:delayMs}}]; if(status>=400||network) return [{json:{ok:false,status,attempts:attempt,error:status===409?'SUPPRESSED_OR_CONFLICT':'ANALYZER_REQUEST_FAILED',message:'Analyzer isteği tamamlanamadı; hassas yanıt ayrıntıları gizlendi.'}}]; return [{json:{...($json.body??$json),retry:{attempts:attempt}}}];"
      }
    },
